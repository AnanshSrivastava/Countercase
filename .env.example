# Copy to .env (make up does this automatically if .env is missing). Never commit .env.

# --- Postgres (shared by api and hindsight) ---
POSTGRES_USER=recoup
POSTGRES_PASSWORD=recoup
POSTGRES_DB=recoup
DATABASE_URL=postgresql://recoup:recoup@db:5432/recoup

# --- Hindsight (agent memory) ---
HINDSIGHT_VERSION=1.2.0
HINDSIGHT_URL=http://hindsight:8888
# LLM used by Hindsight for fact extraction / reflect. Provider still undecided (STATUS.md open question).
HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_MODEL=   (leave unset to use Hindsight's default)
# Groq FREE tier needs on_demand (default 'auto' is rejected with HTTP 400). Free tier = 8k tokens/min, ~3k per retain.
# HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=on_demand
HINDSIGHT_API_LLM_API_KEY=

# --- LLM for drafting / classification (provider undecided) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_DRAFT=
LLM_MODEL_CLASSIFY=

# --- Stripe (test mode) ---
# Webhook secret: `stripe listen --forward-to localhost:8000/core/webhooks/stripe` prints it.
# Without it the webhook endpoint answers 503 (unsigned events are never accepted).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- PayPal (sandbox only; live PayPal is refused in code) ---
# Create an app at developer.paypal.com > Apps & Credentials > Sandbox, then add a webhook for
# CUSTOMER.DISPUTE.CREATED / UPDATED / RESOLVED pointing at <public url>/core/webhooks/paypal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# 0 only together with DEMO_TOOLS=1: lets scripts/paypal_simulate.py replay fixtures unsigned.
PAYPAL_VERIFY_WEBHOOKS=1

# --- Drafting LLM (Anthropic Messages API). Unset = deterministic template claims. ---
# LLM_API_KEY=
# LLM_MODEL_DRAFT=claude-sonnet-5-5

# --- Privacy ---
# Per-seller salted HMAC for customer hashes (IMPROVEMENTS #7). Use a long random value.
CUSTOMER_HASH_SALT=change-me

# --- Web ---
# Host ports (change if something else on your machine already uses them)
DB_PORT=5432
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_FIXTURES=1

# --- Agent wiring (Shivansh) ---
# DISPUTE_SOURCE=auto        # auto = core DB, falling back to fixtures if DB is down | core | fixtures
# MEMORY_BACKEND=inmemory    # inmemory | hindsight (needs make up-memory)
# MEMORY_SEED=full           # inmemory only: full = the whole synthetic history (Hindsight-free demo); demo = 3 cases

# --- Demo only ---
# 1 enables the "Simulate outcome" panel (a stand-in for the bank's decision). Keep 0 anywhere real.
DEMO_TOOLS=0

# --- Deadline alerts (Shivansh, D-15). Without SMTP they are stored as clearly labelled SIMULATED emails. ---
# ALERTS_INTERVAL_SECONDS=60   # >0 checks in the background; 0 = only POST /core/alerts/run (or the /alerts button)
# ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM=recoup@localhost
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
